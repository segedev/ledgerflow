{
  "openapi": "3.1.0",
  "info": {
    "title": "LedgerFlow API",
    "version": "1.0.0",
    "description": "Single-tenant transactional ledger. All money uses minor units. See README for clearing authorization, retries, operational and anomaly-model limits."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "security": [
    {
      "AdminBearer": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Process liveness",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or database operation unconfirmed. See README for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Writable database readiness",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or database operation unconfirmed. See README for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/accounts": {
      "post": {
        "summary": "Create a zero-balance wallet",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or database operation unconfirmed. See README for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewAccount"
              }
            }
          }
        }
      }
    },
    "/v1/accounts/{id}": {
      "get": {
        "summary": "Read account",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or database operation unconfirmed. See README for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            }
          }
        ]
      }
    },
    "/v1/transfers": {
      "post": {
        "summary": "Post or replay a transfer",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResult"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or database operation unconfirmed. See README for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Previously committed transfer replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResult"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Transfer"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
            }
          }
        ]
      }
    },
    "/v1/transfers/{id}": {
      "get": {
        "summary": "Read committed transfer",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResult"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or database operation unconfirmed. See README for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            }
          }
        ]
      }
    },
    "/v1/webhooks/transfers": {
      "post": {
        "summary": "Verify signed webhook and atomically post or replay transfer",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResult"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or database operation unconfirmed. See README for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Webhook"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Webhook-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{10}$"
            }
          },
          {
            "name": "X-Webhook-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "security": [],
        "description": "Custom HMAC-SHA256 protocol: lowercase hexadecimal HMAC of ASCII timestamp + period + exact raw UTF-8 body. Timestamp must be within 300 seconds of server time. Not a native payment-provider signature scheme."
      }
    },
    "/v1/reconciliation": {
      "get": {
        "summary": "Audit an internal ledger snapshot; discrepancies return ok=false",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reconciliation"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or database operation unconfirmed. See README for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/anomalies/score": {
      "post": {
        "summary": "Score an amount using historical outgoing transfers",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnomalyResult"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or database operation unconfirmed. See README for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnomalyInput"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "NewAccount": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "currency": {
            "type": "string",
            "enum": ["NGN", "USD", "GBP", "EUR"]
          }
        },
        "required": ["id", "currency"]
      },
      "Transfer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fromAccountId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "toAccountId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9000000000000,
            "description": "Amount in integer minor units."
          },
          "currency": {
            "type": "string",
            "enum": ["NGN", "USD", "GBP", "EUR"]
          }
        },
        "required": ["fromAccountId", "toAccountId", "amount", "currency"]
      },
      "Webhook": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
          },
          "transfer": {
            "$ref": "#/components/schemas/Transfer"
          }
        },
        "required": ["eventId", "idempotencyKey", "transfer"]
      },
      "AnomalyInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "currency": {
            "type": "string",
            "enum": ["NGN", "USD", "GBP", "EUR"]
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9000000000000,
            "description": "Amount in integer minor units."
          }
        },
        "required": ["accountId", "currency", "amount"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "TransferResult": {
        "type": "object",
        "properties": {
          "fromAccountId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "toAccountId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9000000000000,
            "description": "Amount in integer minor units."
          },
          "currency": {
            "type": "string",
            "enum": ["NGN", "USD", "GBP", "EUR"]
          },
          "transferId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "currency": {
            "type": "string",
            "enum": ["NGN", "USD", "GBP", "EUR"]
          },
          "balance": {
            "type": "integer"
          },
          "kind": {
            "enum": ["wallet", "clearing"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Reconciliation": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "counts": {
            "type": "object"
          },
          "currencyTotals": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "issueCount": {
            "type": "integer"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "AnomalyResult": {
        "type": "object",
        "properties": {
          "model": {
            "const": "isolation-forest-v1"
          },
          "status": {
            "enum": ["scored", "insufficient_data"]
          },
          "sampleCount": {
            "type": "integer"
          },
          "requiredSamples": {
            "type": "integer"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "score": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "flagged": {
            "type": ["boolean", "null"]
          },
          "threshold": {
            "type": "number"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    }
  }
}
